// Prisma schema for the Salary Slip system — modeled for a manpower/staffing
// company: employees are deployed at client sites, salary sheets are
// uploaded per (client, period), and each client's Excel layout is
// remembered via a saved column-mapping profile (see SiteColumnProfile).
//
// Postgres (hosted) is the datasource; see .env for DATABASE_URL.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  PAYROLL_MANAGER
  ACCOUNTANT
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// An admin-side login. Table name stays "Admin" (see @@map) so the existing
/// seeded row and its id carry over untouched when this model gained roles.
model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String
  name               String?
  role               UserRole   @default(SUPER_ADMIN)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@map("Admin")
}

model CompanySettings {
  id        String   @id @default(cuid())
  name      String
  address   String?
  logoPath  String?
  mobile    String?
  officePhone String?
  email     String?
  website   String?

  // --- Statutory registration IDs, printed on generated PF/ESI/LWF filing
  // files. Left blank until the admin fills them in via Settings — every
  // filing route still works without them (the file just prints a blank
  // establishment ID), so this never blocks a first upload.
  pfEstablishmentId String? // EPFO establishment ID, e.g. "MH/BAN/1234567/000"
  esicEmployerCode  String? // 17-digit ESIC employer code
  lwfRegistrationNo String?

  // --- Statutory contribution rates, all admin-editable in Settings instead
  // of hardcoded, since these are set by government notification and do
  // change over time. Defaults are the commonly published current rates —
  // verify against the live EPFO/ESIC/state LWF rules before a first real
  // filing; do not trust the defaults blindly for a live challan/ECR.
  epfEmployerTotalRate Float @default(12) // employer share -> EPF+EPS combined, % of EPF wages, before splitting
                                           // into EPS (epfEmployerEpsRate) and the EPF-proper remainder
  epfEmployerEpsRate Float @default(8.33) // employer share -> EPS, % of EPS wages (capped at epsWageCeiling)
  epfEmployerPfRate  Float @default(3.67) // employer share -> EPF proper, % of EPF wages (used as a fallback; the
                                           // ECR generator actually computes this as epfEmployerTotalRate of EPF
                                           // wages minus the EPS amount, which only equals this flat rate when
                                           // epfEmployerTotalRate is 12)
  epfEdliRate        Float @default(0.5)  // employer -> EDLI insurance, % of EDLI wages (capped at epsWageCeiling)
  epfAdminChargeRate Float @default(0.5)  // employer -> EPF admin charges, % of EPF wages
  epfAdminChargeMin  Float @default(500)  // statutory minimum monthly EPF admin charge when there's >=1 member
  epsWageCeiling     Float @default(15000) // EPS + EDLI contribution wage cap per member

  esiEmployerRate  Float @default(3.25) // employer share, % of gross wages
  esiWageCeiling   Float @default(21000) // gross wage ceiling for ESI applicability — employees above
                                          // this are not covered, so no ESI (employee or employer) applies

  // Tamil Nadu-style LWF: a percentage of gross wages, each side capped at a
  // fixed max amount per period. Re-set these fields if a different state's
  // LWF rules apply.
  lwfEmployeeRate   Float @default(0.2)  // employee share, % of gross wages
  lwfEmployeeMaxAmt Float @default(35)   // employee contribution cap (₹/period)
  lwfEmployerRate   Float @default(0.4)  // employer share, % of gross wages
  lwfEmployerMaxAmt Float @default(70)   // employer contribution cap (₹/period)

  // --- Billing / invoice info, printed on generated Client Bill PDFs
  // (see bill.service.ts / pdf.service.ts). Purely informational — GSTIN is
  // shown on the bill but no GST is computed or added to the total; bank
  // details are for the client's reference when remitting payment.
  gstin          String? // company's GST identification number
  bankName       String?
  bankAccountNo  String?
  bankIfscCode   String?
  billingTerms   String? // free-text payment terms/notes, e.g. "Payment due within 15 days of invoice date"

  updatedAt DateTime @updatedAt
}

/// A client site the manpower company deploys workers to (e.g. "Imperial
/// Auto", "Victura Automotive"). This is the central entity distinguishing
/// a staffing company from a single-company payroll tool.
model Client {
  id            String              @id @default(cuid())
  name          String              @unique
  address       String?
  contactPerson String?
  contactPhone  String?
  contactEmail  String?
  billingRate   Float? // optional per-employee billing/markup rate, for future client invoicing
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  salarySheets  SalarySheet[]
  employees     Employee[] // employees currently deployed here (denormalized convenience pointer)
  columnProfile SiteColumnProfile?
  clientBills   ClientBill[]
}

/// Saved Excel column mapping for one client's sheet layout, built once via
/// the mapping screen and reused on every later upload for that client.
/// `mapping` is a JSON object: { [canonicalField]: { columnIndex, headerText } }.
/// `headerText` is a fingerprint — if the column at `columnIndex` no longer
/// has a matching header on a later upload, the parser flags it for
/// re-mapping instead of silently reading the wrong column.
model SiteColumnProfile {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String   @unique
  headerRow Int // 0-based row index in the sheet treated as the header row
  mapping   Json
  updatedAt DateTime @updatedAt
}

model Employee {
  id                 String         @id @default(cuid())
  employeeCode       String         @unique
  name               String
  guardianName       String?
  dob                DateTime?
  aadhaarNo          String?
  isIndianNational   Boolean        @default(true)
  passportNo         String? // used instead of aadhaarNo on the LWF worker data file when isIndianNational is false
  epfNo              String? // EPF member number — distinct from uanNo, needed for the LWF worker data file
  dateOfJoining      DateTime?
  dateOfRelieving    DateTime?
  qualification      String?
  domicileOfHaryana  Boolean?
  gender             String?
  designation        String?
  department         String?
  bankAccount        String?
  ifscCode           String?
  uanNo              String?
  esiNo              String?
  email              String?
  phone              String? // for WhatsApp / SMS payslip delivery
  currentClient      Client?        @relation(fields: [currentClientId], references: [id])
  currentClientId    String?
  portalPasswordHash String? // set once self-service portal access is enabled for this employee
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  salaryRecords      SalaryRecord[]
  advanceEntries     AdvanceEntry[]
}

model SalarySheet {
  id            String         @id @default(cuid())
  client        Client         @relation(fields: [clientId], references: [id])
  clientId      String
  fileName      String
  filePath      String? // the originally uploaded .xlsx, kept on disk so it can be re-downloaded later
                         // (see storage/salary-sheets/<id>/); null for sheets uploaded before this existed
  periodMonth   Int
  periodYear    Int
  uploadedAt    DateTime       @default(now())
  recordCount   Int            @default(0)
  salaryRecords SalaryRecord[]
  clientBill    ClientBill?

  @@index([clientId, periodYear, periodMonth])
}

/// The client-facing bill for one uploaded sheet, generated automatically right after that
/// sheet's payslips are — one bill per (client, period) upload. Wage cost is each employee's
/// Gross Earnings plus the employer's share of PF/ESI/LWF (the agency fronts these, so they're
/// billable), using the same per-employee formulas as the statutory filings in
/// statutory.service.ts, so a bill's contribution figures always match what actually gets
/// filed. Service charge is the client's billingRate (flat amount) times the employees billed
/// this period; totals are snapshotted at generation time so a bill doesn't silently change if
/// CompanySettings' contribution rates are edited later.
model ClientBill {
  id               String      @id @default(cuid())
  sheet            SalarySheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  sheetId          String      @unique
  client           Client      @relation(fields: [clientId], references: [id])
  clientId         String
  periodMonth      Int
  periodYear       Int
  employeeCount    Int
  totalGrossWages  Float
  totalEmployerEpf Float // employer EPS + EPF-diff + EDLI, summed
  totalEmployerEsi Float
  totalEmployerLwf Float
  pfAdminCharge    Float // one establishment-level EPF admin charge, not per employee
  billingRateUsed  Float? // Client.billingRate snapshot at generation time; null if never set
  serviceCharge    Float // billingRateUsed * employeeCount
  totalWageCost    Float // gross + employer epf/esi/lwf + pfAdminCharge
  grandTotal       Float // totalWageCost + serviceCharge
  lines            Json // itemized per-employee breakdown: [{ employeeId, employeeCode, name, designation,
                         // paidDays, grossEarnings, employerEpf, employerEsi, employerLwf, wageCost }]
  pdfPath          String
  generatedAt      DateTime    @default(now())

  @@index([clientId, periodYear, periodMonth])
}

model SalaryRecord {
  id              String        @id @default(cuid())
  sheet           SalarySheet   @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  sheetId         String
  employee        Employee      @relation(fields: [employeeId], references: [id])
  employeeId      String

  paidDays        Float         @default(0)
  otHours         Float         @default(0)
  otAmount        Float         @default(0)

  basic           Float         @default(0)
  monthlySalary   Float         @default(0) // full monthly entitlement, unprorated — reference only, not part of Gross Earnings
  hra             Float         @default(0)
  monthlyHra      Float         @default(0) // full monthly HRA entitlement, unprorated — reference only, mirrors monthlySalary
  incentive       Float         @default(0)
  otherEarnings   Json? // itemized breakdown of `incentive`'s source columns as [{ label, amount }], so the
                        // payslip can list each other-earning column (Arrear, Conveyance, ...) separately
                        // instead of only the summed `incentive` total
  grossEarnings   Float         @default(0)
  pfSalaryAmt     Float         @default(0) // PF-qualifying wage base — kept for reporting; not shown on the payslip itself

  esi             Float         @default(0)
  epf             Float         @default(0)
  lwf             Float         @default(0)
  advance         Float         @default(0)
  dressShoes      Float         @default(0)
  otherDeduction  Float         @default(0)
  totalDeductions Float         @default(0)

  netPay          Float         @default(0)
  extra           Json?
  payslip         Payslip?
  advanceEntry    AdvanceEntry? // auto-created RECOVERED entry when `advance` > 0

  @@unique([sheetId, employeeId])
}

model Payslip {
  id             String       @id @default(cuid())
  salaryRecord   SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)
  salaryRecordId String       @unique
  pdfPath        String
  generatedAt    DateTime     @default(now())
  emailedAt      DateTime?
  whatsappedAt   DateTime?
}

enum AdvanceEntryType {
  ISSUED
  RECOVERED
}

/// Running advance ledger per employee: manual ISSUED entries (cash advance
/// given outside payroll) plus automatic RECOVERED entries created whenever
/// a salary record deducts an "Advance" amount during payslip generation.
model AdvanceEntry {
  id             String           @id @default(cuid())
  employee       Employee         @relation(fields: [employeeId], references: [id])
  employeeId     String
  type           AdvanceEntryType
  amount         Float
  date           DateTime         @default(now())
  note           String?
  salaryRecord   SalaryRecord?    @relation(fields: [salaryRecordId], references: [id])
  salaryRecordId String?          @unique
  createdAt      DateTime         @default(now())

  @@index([employeeId, date])
}
