# Copy this file to .env and fill in real values before running the server.

# Postgres connection string.
DATABASE_URL="postgresql://user:password@host:5432/payslip?schema=public"

# Secret used to sign admin/employee JWT sessions (and signed payslip
# download links). Use a long random string in production.
JWT_SECRET="change-this-to-a-long-random-secret"

# How long an admin login session stays valid.
JWT_EXPIRES_IN="8h"

# Port the API server listens on.
PORT=4000

# Comma-separated list of allowed frontend origins (for CORS). Any
# http://localhost:<port> origin is always allowed in addition to this list.
CORS_ORIGIN="http://localhost:5173"

# Public URL this API is reachable at. Used to build payslip download links
# for WhatsApp messages — must be a real internet-reachable HTTPS URL for
# WhatsApp delivery to work (Twilio cannot reach localhost).
PUBLIC_BASE_URL="http://localhost:4000"

# Initial admin account created by `npm run seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Company details used on generated payslips.
COMPANY_NAME="Your Company Pvt Ltd"
COMPANY_ADDRESS="123 Business Street, City, Country"

# --- Optional: email payslip delivery (bulk "Send by Email") ---
# Leave unset to disable the feature (it reports "not configured" per send).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Payroll <payroll@example.com>"

# --- Optional: WhatsApp payslip delivery (bulk "Send by WhatsApp") ---
# Requires a Twilio account with WhatsApp enabled. Leave unset to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
